<!--
  Java4Shell (CVE-2026-114938) - Wazuh rules
  ID block: 100510-100530. Tune levels and IDs to your environment.
  Install to /var/ossec/etc/rules/ on the manager, then restart wazuh-manager.
-->

<group name="java4shell,cve_2026_114938,">

  <!-- Layer 1: exposure inventory (scanner/java4shell-check.sh).
       Anchored on the decoded field, not <decoded_as>: the scanner runs as a
       logcollector <command>, so the line arrives under the built-in `ossec`
       parent decoder and our fields are added by a child. Keying on j4s_verdict
       fires for both the wrapped (command) and bare (file / logtest) forms. -->
  <rule id="100510" level="0">
    <field name="j4s_verdict">\w+</field>
    <description>Java4Shell exposure scan result.</description>
  </rule>

  <rule id="100511" level="12">
    <if_sid>100510</if_sid>
    <field name="j4s_verdict">^EXPOSED$</field>
    <description>Java4Shell (CVE-2026-114938): Java $(j4s_line) at $(j4s_version) on an AVX-512 VBMI CPU ($(j4s_bin)). Patch and restart now.</description>
    <group>vulnerability,</group>
  </rule>

  <rule id="100512" level="7">
    <if_sid>100510</if_sid>
    <field name="j4s_verdict">^AFFECTED$</field>
    <description>Java4Shell: affected Java $(j4s_line) at $(j4s_version) found; CPU lacks AVX-512 VBMI. Patch on the next window.</description>
    <group>vulnerability,</group>
  </rule>

  <rule id="100513" level="9">
    <if_sid>100510</if_sid>
    <field name="j4s_verdict">^AFFECTED_NOFIX$</field>
    <description>Java4Shell: Java $(j4s_line) at $(j4s_version) is affected and has no fixed build. Move to a supported line.</description>
    <group>vulnerability,</group>
  </rule>

</group>

<group name="java4shell,cve_2026_114938,jvm_crash,">

  <!-- Layer 2: JVM crash. 100520 marks the fatal-error header of a crash report. -->
  <rule id="100520" level="8">
    <match>A fatal error has been detected by the Java Runtime Environment</match>
    <description>JVM fatal error reported (crash).</description>
  </rule>

  <!-- Keys on HotSpot-internal symbols that only appear in a JVM crash dump.
       HIGH confidence, but it only fires on the SYNCHRONOUS crash variant, where the
       out-of-bounds store faults immediately inside the decode stub. Live-lab finding
       (Temurin 21.0.5, EPYC Genoa): the overflow did NOT fault in the stub in any run.
       It corrupts adjacent heap memory and the JVM dies somewhere else, a little later:
       in GC in one run (DefNewGeneration::copy_to_survivor_space), in JIT-compiled
       application code in another. NO decode-intrinsic frame in either stack. This rule does not fire on that case; 100522 does. -->
  <rule id="100521" level="13">
    <regex type="pcre2">base64_decodeBlock|StubRoutines::.{0,40}base64</regex>
    <description>Java4Shell (CVE-2026-114938): JVM crash stack references the Base64 decode intrinsic. Treat as an exploitation attempt.</description>
    <group>attack,</group>
  </rule>

  <!-- The realistic crash signature. The OOB write usually manifests as a delayed
       heap-corruption crash: a JVM fatal SIGSEGV/SIGBUS with a program counter, the
       distinctive hs_err header line "SIGSEGV (0xb) at pc=0x...". This fires on ANY
       hard JVM crash, so it is level 11 (investigate), not an attack verdict on its own.
       On a Base64-exposed service (Layer 1 EXPOSED) or alongside a malformed-token hit
       (Layer 3), treat an unexplained SIGSEGV as possible Java4Shell heap corruption.
       Validated: this is the rule that fires on the crash the lab actually reproduced. -->
  <rule id="100522" level="11">
    <regex type="pcre2">SIG(SEGV|BUS|ILL|FPE)\s+\(0x[0-9a-f]+\)\s+at pc=0x</regex>
    <description>Java4Shell (CVE-2026-114938): JVM fatal signal in a crash dump (possible Base64 heap corruption). Correlate with exposure (Layer 1) and malformed tokens (Layer 3).</description>
    <group>attack,</group>
  </rule>

</group>

<group name="java4shell,cve_2026_114938,">

  <!-- Layer 3: malformed Base64 token on the wire (opportunistic).
       Adapt decoded_as and the field name to how your proxy or WAF logs the Authorization
       value. A valid Base64 value that ends in ONE "=" has a body of 4n+3 characters.
       The trigger has a body of 4n, 4n+1 or 4n+2 characters before the single "=", so the
       regex counts the body in groups of four and allows at most two leftovers. An
       ordinary Basic credential ending in a single "=" does not match. -->
  <rule id="100525" level="10">
    <decoded_as>json</decoded_as>
    <field name="authorization" type="pcre2">(?i)^(basic|bearer)\s+(?:[A-Za-z0-9+/_-]{4}){10,}[A-Za-z0-9+/_-]{0,2}=\s*$</field>
    <description>Java4Shell: malformed Base64 token (invalid length before a single trailing padding) in an Authorization value. Possible trigger.</description>
    <group>attack,</group>
  </rule>

</group>

<group name="java4shell,cve_2026_114938,post_exploitation,">

  <!-- Layer 4: java spawns a shell or download tool. Windows, Sysmon Event ID 1.
       NOT lab-validated. Baseline CI/build nodes (Jenkins, Gradle) before promoting;
       they spawn shells legitimately.
       There is deliberately no Linux rule: win.eventdata.* exists only for Windows
       eventchannel events, so a Linux rule written against those fields never matches.
       On Linux, write the same parent/child match against the fields your own process
       telemetry decodes to (auditd or Sysmon for Linux) and prove it with wazuh-logtest. -->
  <rule id="100530" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\javaw?\.exe$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(cmd|powershell|pwsh|wscript|cscript|mshta|certutil|bitsadmin|curl)\.exe$</field>
    <description>Java4Shell: java spawned $(win.eventdata.image). Possible post-exploitation command execution.</description>
    <mitre><id>T1190</id><id>T1059</id></mitre>
    <group>attack,</group>
  </rule>


</group>
